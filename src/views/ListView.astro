---
import type { Page } from 'astro';
import { LANGS, type Lang } from '../site.config';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import AdSlot from '../components/AdSlot.astro';
import Pagination from '../components/Pagination.astro';
import RegionChips from '../components/RegionChips.astro';
import type { Post } from '../lib/posts';
import { t } from '../i18n/ui';
import { localePath, listAlternates, pageSuffix } from '../lib/postUtils';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  page: Page<Post>;
  basePath: string;
  alternates?: Partial<Record<Lang, string>>;
  noindex?: boolean;
  /** 목록 위에 보여 줄 지역 칩(regions.json 키). 해외 목록에서 도시별로 들어가는 길(2026-10-27). */
  chips?: string[];
}
const { lang, title, description, page, basePath, alternates: alternatesProp, noindex = false, chips = [] } = Astro.props;
const suffix = pageSuffix(page.currentPage);
const path = localePath(lang, `${basePath}${suffix}`);
const alternates = alternatesProp ?? listAlternates(basePath, suffix, LANGS);
// 2페이지부터는 제목·설명에 페이지 번호를 붙여 같은 제목이 반복되지 않게 한다(중복 제목 방지).
const pageLabel = page.currentPage > 1 ? t(lang, 'list.pageN', { n: String(page.currentPage) }) : '';
const seoTitle = pageLabel ? `${title} – ${pageLabel}` : title;
const seoDescription = pageLabel ? `${description} (${pageLabel})` : description;
// 글이 0편인 목록 페이지는 "아직 글이 없어요" 한 줄뿐이라 서치콘솔이 Soft 404 로 판정한다(2026-10-27 /en/overseas/).
// 글이 생길 때까지 noindex 로 두고, 사이트맵에서는 scripts/lib/thin-tags.mjs 의 emptyScopePaths 가 같은 기준으로 뺀다.
const robotsNoindex = noindex || page.data.length === 0;
---
<BaseLayout lang={lang} title={seoTitle} description={seoDescription} path={path} alternates={alternates} noindex={robotsNoindex}>
  <section class="section container">
    <header class="list-head">
      <h1>{title}{pageLabel && <span class="muted page-label"> · {pageLabel}</span>}</h1>
      <p class="muted">{description}</p>
      {chips.length > 0 && <div class="list-chips"><RegionChips lang={lang} keys={chips} /></div>}
    </header>
    {page.data.length === 0 ? (
      <p class="muted">{t(lang, 'list.empty')}</p>
    ) : (
      <div class="grid">
        {page.data.map((post, i) => (
          <>
            <PostCard post={post} lang={lang} eager={i < 3} headingLevel={2} />
            {i === 5 && <div class="span-all"><AdSlot lang={lang} slot="list" /></div>}
          </>
        ))}
      </div>
    )}
    <Pagination page={page} lang={lang} />
  </section>
</BaseLayout>
<style>
  .list-head { margin-bottom: 1.5rem; }
  .list-head p { margin: 0; }
  .list-chips { margin-top: 1rem; }
  .page-label { font-size: .6em; font-weight: 500; }
  .span-all { grid-column: 1 / -1; }
</style>
