---
import siteConfig, { type Lang } from '../site.config';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import RegionChips from '../components/RegionChips.astro';
import HubSection from '../components/HubSection.astro';
import AdSlot from '../components/AdSlot.astro';
import { getPosts } from '../lib/posts';
import { t } from '../i18n/ui';
import { localePath } from '../lib/postUtils';
import { organizationJsonLd, ORG_ID } from '../lib/jsonld';
import { resolveHubs } from '../lib/hubs';

interface Props { lang: Lang }
const { lang } = Astro.props;
const posts = await getPosts(lang);
const latest = posts.slice(0, 9);
// 주제 허브(2026-10-14 감사: 홈에 축제·가이드 허브가 없어 검색 의도와 맞지 않았다). 정의는 src/data/hubs.json
const hubs = resolveHubs(lang, posts);
const regionKeys = [...new Set(posts.map((p) => p.data.region))];
// 한/영 상단 이미지는 brand-assets.mjs 에서 같은 캔버스(1200x1314)로 생성하고, 표시 폭(최대 400px)에 맞춰 800px 로 줄여 둔다
const heroSrc = lang === 'ko' ? '/brand/hero.webp' : '/brand/hero-en.webp';

// 구글 검색 결과의 "사이트 이름" 신호. 구글은 도메인당 이름 하나만 고르고 /en/, /ja/ 같은
// 하위 경로에는 따로 주지 않으므로, 세 홈 모두 같은 마크업을 넣고 한국어 이름을 name 으로,
// 영어·일본어 이름과 도메인을 alternateName 으로 둔다(2026-10-12, 검색 결과에 nowyeogi.com 으로 나오던 문제).
const base = siteConfig.url.replace(/\/$/, '');
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: siteConfig.name.ko,
    alternateName: [siteConfig.name.en, siteConfig.name.ja, new URL(siteConfig.url).hostname],
    url: `${base}/`,
    publisher: { '@id': ORG_ID },
  },
  { '@context': 'https://schema.org', ...organizationJsonLd(lang) },
];
---
<BaseLayout lang={lang} title={siteConfig.homeTitle[lang]} description={siteConfig.description[lang]} path={localePath(lang, '/')} alternates={{ ko: '/', en: '/en/', ja: '/ja/' }} autoLang={lang === 'ko'} jsonLd={jsonLd}>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-text">
        <p class="eyebrow">{t(lang, 'scope.domestic')} · {t(lang, 'scope.overseas')}</p>
        <h1>{siteConfig.name[lang]}</h1>
        <p class="tagline">{siteConfig.tagline[lang]}</p>
      </div>
      <img class="hero-art" src={heroSrc} alt={siteConfig.name[lang]} width="800" height="876" loading="eager" fetchpriority="high" />
    </div>
  </section>

  {hubs.length > 0 && (
    <section class="section container hubs-section" aria-label={t(lang, 'home.hubs')}>
      <HubSection lang={lang} hubs={hubs} />
    </section>
  )}

  <section class="section container">
    <div class="section-title">
      <h2>{t(lang, 'home.latest')}</h2>
      <a class="small" href={localePath(lang, '/domestic/')}>{t(lang, 'home.more')} →</a>
    </div>
    {latest.length === 0 ? (
      <p class="muted">{t(lang, 'list.empty')}</p>
    ) : (
      <div class="grid">
        {latest.map((post, i) => (
          <>
            <PostCard post={post} lang={lang} eager={i < 3} />
            {i === 5 && <div class="span-all"><AdSlot lang={lang} slot="list" /></div>}
          </>
        ))}
      </div>
    )}
  </section>

  {regionKeys.length > 0 && (
    <section class="section container">
      <div class="section-title"><h2>{t(lang, 'home.regions')}</h2></div>
      <RegionChips lang={lang} keys={regionKeys} />
    </section>
  )}
</BaseLayout>
<style>
  .hero { padding: 3rem 0 2rem; background: radial-gradient(ellipse at 20% 0%, var(--c-primary-soft), transparent 60%), radial-gradient(ellipse at 90% 20%, var(--c-accent-2), transparent 50%); }
  .eyebrow { color: var(--c-primary-deep); font-weight: 600; letter-spacing: .08em; font-size: .85rem; margin-bottom: .6em; }
  .hero h1 { font-size: clamp(2rem, 5vw, 3rem); margin-bottom: .3em; }
  .tagline { max-width: 40ch; color: var(--c-muted); font-size: 1.1rem; margin: 0; }
  .hero-inner { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); align-items: center; gap: 2rem; }
  .hero-inner > * { min-width: 0; }
  .hero-art { display: block; width: 100%; max-width: min(400px, 100%); height: auto; justify-self: center; border-radius: var(--radius); }
  /* 모바일: 그림을 줄여 첫 화면에 최신 글이 보이게 한다(2026-10-13 감사: 히어로가 첫 화면을 다 차지했다) */
  @media (max-width: 760px) { .hero { padding: 2rem 0 1.25rem; } .hero-inner { grid-template-columns: minmax(0, 1fr); gap: 1rem; } .hero-art { max-width: min(220px, 100%); margin-inline: auto; } }
  .span-all { grid-column: 1 / -1; }
  .hubs-section { padding-top: 1.5rem; }
</style>
