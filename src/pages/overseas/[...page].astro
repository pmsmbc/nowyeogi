---
import type { GetStaticPaths } from 'astro';
import ListView from '../../views/ListView.astro';
import siteConfig from '../../site.config';
import { getPosts } from '../../lib/posts';
import { t } from '../../i18n/ui';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getPosts('ko')).filter((p) => p.data.scope === 'overseas');
  return paginate(posts, { pageSize: siteConfig.postsPerPage });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---
<ListView lang="ko" title={t('ko', 'scope.overseas')} description={`해외 여행 정보 ${page.total}편. 도시별 숙소, 맛집, 볼거리, 교통 안내를 공식 자료 기준으로 정리했어요.`} page={page} basePath="/overseas/" />
