---
import type { GetStaticPaths } from 'astro';
import ListView from '../../../views/ListView.astro';
import siteConfig from '../../../site.config';
import { getPosts } from '../../../lib/posts';
import { t } from '../../../i18n/ui';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getPosts('ja')).filter((p) => p.data.scope === 'domestic');
  return paginate(posts, { pageSize: siteConfig.postsPerPage });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---
<ListView lang="ja" title={t('ja', 'scope.domestic')} description={`韓国の旅行ガイド${page.total}本。地域別の宿、グルメ、祭り、観光、交通を公式資料をもとにまとめました。`} page={page} basePath="/domestic/" />
