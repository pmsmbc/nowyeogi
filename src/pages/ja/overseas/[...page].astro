---
import type { GetStaticPaths } from 'astro';
import ListView from '../../../views/ListView.astro';
import siteConfig from '../../../site.config';
import { getPosts } from '../../../lib/posts';
import { t } from '../../../i18n/ui';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getPosts('ja')).filter((p) => p.data.scope === 'overseas');
  return paginate(posts, { pageSize: siteConfig.postsPerPage });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---
<ListView lang="ja" title={t('ja', 'scope.overseas')} description={`海外の旅行ガイド${page.total}本。都市別の宿、グルメ、観光、交通を公式資料をもとにまとめました。`} page={page} basePath="/overseas/" />
