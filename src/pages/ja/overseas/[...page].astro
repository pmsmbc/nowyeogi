---
import type { GetStaticPaths } from 'astro';
import ListView from '../../../views/ListView.astro';
import siteConfig from '../../../site.config';
import { getPosts } from '../../../lib/posts';
import { t } from '../../../i18n/ui';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getPosts('ja')).filter((p) => p.data.scope === 'overseas');
  // 해외 목록 위에 도시 칩을 둔다(도쿄 등). 글이 있는 지역만, 글 순서대로.
  const chips = [...new Set(posts.map((p) => p.data.region))];
  return paginate(posts, { pageSize: siteConfig.postsPerPage, props: { chips } });
}) satisfies GetStaticPaths;

const { page, chips } = Astro.props;
---
<ListView lang="ja" title={t('ja', 'scope.overseas')} description={`海外の旅行ガイド${page.total}本。都市別の宿、グルメ、観光、交通を公式資料をもとにまとめました。`} page={page} basePath="/overseas/" chips={chips} />
