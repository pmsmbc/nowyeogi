---
import type { GetStaticPaths } from 'astro';
import ListView from '../../../../views/ListView.astro';
import siteConfig, { LANGS, type Lang } from '../../../../site.config';
import { getPosts } from '../../../../lib/posts';
import { regionName } from '../../../../data/regions';
import { t } from '../../../../i18n/ui';
import { listAlternates, pageSuffix } from '../../../../lib/postUtils';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts('en');
  const byLang = Object.fromEntries(await Promise.all(LANGS.map(async (l) => [l, await getPosts(l)]))) as Record<Lang, typeof posts>;
  const keys = [...new Set(posts.map((p) => p.data.region))];
  return keys.flatMap((region) => {
    // 같은 지역 글이 있는 언어만 hreflang 에 넣는다(세 언어가 서로를 빠짐없이 가리켜야 한다)
    const langs = LANGS.filter((l) => byLang[l].some((p) => p.data.region === region));
    return paginate(posts.filter((p) => p.data.region === region), {
      params: { region },
      pageSize: siteConfig.postsPerPage,
      props: { langs },
    });
  });
}) satisfies GetStaticPaths;

const { page, langs } = Astro.props;
const { region } = Astro.params;
const name = regionName(region!, 'en');
const alternates = listAlternates(`/regions/${region}/`, pageSuffix(page.currentPage), langs);
---
<ListView lang="en" title={t('en', 'region.title', { region: name })} description={`${page.total} travel guides for ${name}: where to stay, what to eat, what to see and how to get around, compiled from official sources.`} page={page} basePath={`/regions/${region}/`} alternates={alternates} />
