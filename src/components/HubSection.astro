---
import type { Lang } from '../site.config';
import { postPath } from '../lib/posts';
import { localePath } from '../lib/postUtils';
import { t } from '../i18n/ui';
import { hubLabel, type HubResolved } from '../lib/hubs';

interface Props { lang: Lang; hubs: HubResolved[] }
const { lang, hubs } = Astro.props;
---
<div class="hubs">
  {hubs.map(({ hub, posts }) => (
    <section class="hub" aria-labelledby={`hub-${hub.key}`}>
      <h2 id={`hub-${hub.key}`}>{hub.title[lang]}</h2>
      <p class="small muted">{hub.description[lang]}</p>
      <ul>
        {posts.map((p) => <li><a href={postPath(p)} title={p.data.title}>{hubLabel(p.data.title)}</a></li>)}
      </ul>
      {hub.more && <a class="more small" href={localePath(lang, hub.more)}>{t(lang, 'home.more')} →</a>}
    </section>
  ))}
</div>
<style>
  .hubs { display: grid; gap: 1.2rem; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
  .hub { background: var(--c-surface); border: 1px solid var(--c-line); border-radius: var(--radius); padding: 1.2rem 1.3rem; box-shadow: var(--shadow-sm); display: flex; flex-direction: column; }
  .hub h2 { font-size: 1.15rem; margin: 0 0 .25em; }
  .hub p { margin: 0 0 .8em; }
  .hub ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .45rem; }
  .hub li { padding-left: 1em; position: relative; font-size: .95rem; line-height: 1.45; }
  .hub li::before { content: '·'; position: absolute; left: .2em; color: var(--c-primary); font-weight: 700; }
  .hub li a { color: var(--c-text); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .hub li a:hover { color: var(--c-primary-deep); }
  .more { margin-top: auto; padding-top: .9em; align-self: flex-start; }
  /* 좁은 화면에서는 목록 한 줄의 터치 영역을 32px 이상으로 넓힌다 (2026-10-22) */
  @media (max-width: 640px) {
    .hub ul { gap: .1rem; }
    .hub li a { padding: .32rem 0; }
    .hub li::before { top: .32rem; }
    .more { padding: .3rem 0; }
  }
</style>
