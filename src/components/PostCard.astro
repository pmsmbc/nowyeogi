---
import type { Lang } from '../site.config';
import type { Post } from '../lib/posts';
import { postPath } from '../lib/posts';
import { t, formatDate, type UiKey } from '../i18n/ui';
import { regionName } from '../data/regions';
import { responsiveAttrs, SIZES_CARD } from '../lib/responsive.mjs';

interface Props { post: Post; lang: Lang; eager?: boolean; headingLevel?: 2 | 3 }
const { post, lang, eager = false, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const cover = post.data.images.find((i) => i.src === post.data.cover);
const coverAttrs = responsiveAttrs(post.data.cover, { width: cover?.width, sizes: SIZES_CARD });
---
{/* 카드 어디를 눌러도 글로 간다. 제목 링크 하나를 ::after 로 카드 크기만큼 늘리는 방식(stretched link)이라
    사진에 따로 링크를 두지 않는다(같은 곳으로 가는 링크가 둘이면 스크린리더에 두 번 읽힌다). 카드 안에 다른 링크가 없어서 가능하다 (2026-10-22) */}
<article class="card">
  <div class="cover">
    <img {...coverAttrs} alt={cover?.alt ?? ''} width={cover?.width ?? 1600} height={cover?.height ?? 1000} loading={eager ? 'eager' : 'lazy'} decoding="async" />
  </div>
  <div class="body">
    <div class="meta">
      <span class="badge">{regionName(post.data.region, lang)}</span>
      <span class={`badge ${post.data.type === 'food' ? 'accent' : ''}`}>{t(lang, `type.${post.data.type}` as UiKey)}</span>
    </div>
    <Heading class="card-title"><a href={postPath(post)}>{post.data.title}</a></Heading>
    <p class="small muted">{post.data.description}</p>
    <time class="small muted" datetime={post.data.pubDate.toISOString()}>{formatDate(lang, post.data.pubDate)}</time>
  </div>
</article>
<style>
  .card { position: relative; background: var(--c-surface); border-radius: var(--radius); box-shadow: var(--shadow-sm); overflow: hidden; display: flex; flex-direction: column; transition: transform .2s, box-shadow .2s; }
  .card:hover, .card:focus-within { transform: translateY(-3px); box-shadow: var(--shadow); }
  /* 제목 링크의 클릭 영역을 카드 전체로 */
  .card-title a::after { content: ''; position: absolute; inset: 0; }
  .card-title a:focus-visible { outline: none; }
  .card:has(.card-title a:focus-visible) { outline: 3px solid var(--c-primary-darker); outline-offset: 2px; }
  .cover img { aspect-ratio: 16 / 10; object-fit: cover; width: 100%; }
  .body { padding: 1.1rem 1.2rem 1.3rem; display: flex; flex-direction: column; gap: .5rem; }
  .meta { display: flex; gap: .4rem; }
  .card-title { margin: 0; font-size: 1.1rem; }
  .card-title a { color: var(--c-text); }
  p { margin: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
</style>
