---
import siteConfig, { type Lang } from '../site.config';
import { t } from '../i18n/ui';
import { localePath } from '../lib/postUtils';
import LangSwitch from './LangSwitch.astro';

interface Props { lang: Lang; alternates?: Partial<Record<Lang, string>> }
const { lang, alternates } = Astro.props;
const nav = [
  { href: localePath(lang, '/domestic/'), label: t(lang, 'nav.domestic') },
  // 2026-10-27 첫 해외 글(도쿄)과 함께 탭을 켰다. 글이 없는 동안은 ListView 가 /overseas/ 를 noindex 로 둔다.
  { href: localePath(lang, '/overseas/'), label: t(lang, 'nav.overseas') },
  { href: localePath(lang, '/about/'), label: t(lang, 'nav.about') },
  { href: localePath(lang, '/search/'), label: t(lang, 'nav.search') },
];
---
<header class="site-header" data-header>
  <div class="container row">
    <a class="logo" href={localePath(lang, '/')}>
      <img src="/brand/logo-mark-72.webp" alt="" width="36" height="36" />
      {siteConfig.name[lang]}
    </a>
    {/* 640px 이하에서만 보이는 햄버거 버튼. 메뉴 글자가 두 줄로 떨어지던 문제 대응(2026-10-14) */}
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label={t(lang, 'a11y.menuOpen')} data-nav-toggle data-label-open={t(lang, 'a11y.menuOpen')} data-label-close={t(lang, 'a11y.menuClose')}>
      <span class="bar" aria-hidden="true"></span>
      <span class="bar" aria-hidden="true"></span>
      <span class="bar" aria-hidden="true"></span>
    </button>
    <nav id="site-nav" class="nav" aria-label={t(lang, 'a11y.mainNav')} data-nav>
      <div class="links">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </div>
      <LangSwitch lang={lang} alternates={alternates} />
    </nav>
  </div>
</header>
<script is:inline>
  (function () {
    var header = document.querySelector('[data-header]');
    var btn = header && header.querySelector('[data-nav-toggle]');
    var nav = header && header.querySelector('[data-nav]');
    if (!btn || !nav) return;
    function setOpen(open) {
      header.classList.toggle('is-open', open);
      if (open) header.classList.remove('is-hidden');
      document.documentElement.classList.toggle('nav-open', open); // 전체 화면 메뉴가 열리면 뒤 페이지 스크롤을 막는다
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      btn.setAttribute('aria-label', open ? btn.dataset.labelClose : btn.dataset.labelOpen);
    }
    btn.addEventListener('click', function () { setOpen(btn.getAttribute('aria-expanded') !== 'true'); });
    nav.addEventListener('click', function (e) { if (e.target.closest('a')) setOpen(false); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && header.classList.contains('is-open')) { setOpen(false); btn.focus(); } });
    document.addEventListener('click', function (e) { if (header.classList.contains('is-open') && !header.contains(e.target)) setOpen(false); });
    // 화면이 넓어지면(데스크톱 메뉴로 전환) 열린 상태를 정리한다
    var mq = window.matchMedia('(min-width: 641px)');
    var onChange = function () { if (mq.matches) setOpen(false); };
    if (mq.addEventListener) mq.addEventListener('change', onChange); else mq.addListener(onChange);
    // 좁은 화면: 아래로 스크롤하면 헤더를 감추고 위로 올리면 다시 보여 준다. 메뉴가 열려 있거나 맨 위 근처면 늘 보인다 (2026-10-22)
    var mobile = window.matchMedia('(max-width: 640px)');
    var lastY = window.scrollY;
    var hidden = false;
    function show() { if (hidden) { hidden = false; header.classList.remove('is-hidden'); } }
    function onScroll() {
      var y = window.scrollY;
      var dy = y - lastY;
      lastY = y;
      if (!mobile.matches || header.classList.contains('is-open') || y < 80) { show(); return; }
      if (dy > 6 && !hidden) { hidden = true; header.classList.add('is-hidden'); }
      else if (dy < -6) show();
    }
    window.addEventListener('scroll', onScroll, { passive: true });
  })();
</script>
<style>
  .site-header { position: sticky; top: 0; z-index: 10; border-bottom: 1px solid var(--c-line); }
  /* 반투명 블러는 가상 요소에 둔다. 헤더 자체에 backdrop-filter 가 있으면 그 헤더가 position: fixed 의 기준이 되어
     모바일 전체 화면 메뉴(.nav)가 헤더 높이(56px) 안에 갇혀 보이지 않았다 (2026-10-22). */
  .site-header::before { content: ''; position: absolute; inset: 0; z-index: -1; background: rgba(251, 250, 247, .85); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); }
  .row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; height: 64px; }
  .logo { font-family: var(--font-head); font-weight: 700; font-size: 1.25rem; color: var(--c-text); display: flex; align-items: center; gap: .5rem; }
  .logo:hover { text-decoration: none; }
  .logo img { width: 36px; height: 36px; }
  .nav, .links { display: flex; align-items: center; gap: 1.1rem; }
  .nav a { color: var(--c-text); font-weight: 500; }
  /* 로고와 메뉴 글자가 한 글자씩 쪼개져 내려가지 않게 한다 */
  .logo, .nav a { white-space: nowrap; }
  .nav-toggle { display: none; }
  :global(html.nav-open) { overflow: hidden; }

  @media (max-width: 640px) {
    .row { height: 56px; }
    /* 스크롤 방향에 따라 헤더를 감춘다. transform 은 감출 때만 걸리므로(평소 none) fixed 메뉴의 기준이 되지 않는다 */
    .site-header { transition: transform .22s ease; }
    .site-header.is-hidden { transform: translateY(-100%); }
    .logo { font-size: 1.05rem; position: relative; z-index: 2; }
    /* 햄버거 버튼: 44px 터치 영역. 열리면 위·아래 막대가 돌아 X 가 되고 가운데 막대는 사라진다 */
    .nav-toggle { display: inline-flex; flex-direction: column; justify-content: center; align-items: center; gap: 6px; width: 44px; height: 44px; margin-right: -8px; border: 0; background: transparent; cursor: pointer; border-radius: var(--radius-sm); position: relative; z-index: 2; -webkit-tap-highlight-color: transparent; }
    .nav-toggle:focus-visible { outline: 3px solid var(--c-primary-darker); outline-offset: 2px; }
    .nav-toggle .bar { display: block; width: 26px; height: 3px; background: var(--c-text); border-radius: 3px; transition: transform .4s cubic-bezier(.68, -.4, .27, 1.4), opacity .25s ease, width .3s ease; transform-origin: center; }
    .is-open .nav-toggle .bar:nth-child(1) { transform: translateY(9px) rotate(45deg); }
    .is-open .nav-toggle .bar:nth-child(2) { opacity: 0; width: 0; }
    .is-open .nav-toggle .bar:nth-child(3) { transform: translateY(-9px) rotate(-45deg); }

    /* 전체 화면 메뉴: 헤더(56px) 아래 화면을 모두 덮는다 */
    .nav { position: fixed; top: 56px; left: 0; right: 0; bottom: 0; z-index: 1; flex-direction: column; align-items: stretch; justify-content: flex-start; gap: 0; padding: 1.25rem 1.5rem 2rem; background: var(--c-bg); overflow-y: auto; opacity: 0; visibility: hidden; transform: translateY(-14px); transition: opacity .28s ease, transform .32s cubic-bezier(.2, .7, .2, 1), visibility 0s linear .32s; }
    .is-open .nav { opacity: 1; visibility: visible; transform: none; transition: opacity .28s ease, transform .32s cubic-bezier(.2, .7, .2, 1), visibility 0s; }
    .links { flex-direction: column; align-items: stretch; gap: 0; }
    .links a { display: flex; align-items: center; justify-content: space-between; padding: 1.1rem .25rem; font-size: 1.45rem; font-weight: 700; font-family: var(--font-head); border-bottom: 1px solid var(--c-line); }
    .links a::after { content: '→'; color: var(--c-primary-deep); font-weight: 500; font-size: 1.1rem; }
    .nav :global(.lang-switch) { padding-top: 1.4rem; gap: .6rem; flex-wrap: wrap; }
    .nav :global(.lang-switch .chip) { font-size: 1rem; padding: .55em 1.1em; }
    /* 열릴 때 항목이 위에서 차례로 들어온다 */
    .links a, .nav :global(.lang-switch) { opacity: 0; transform: translateY(14px); }
    .is-open .links a, .is-open .nav :global(.lang-switch) { animation: nav-in .42s cubic-bezier(.2, .7, .2, 1) both; }
    .is-open .links a:nth-child(1) { animation-delay: .08s; }
    .is-open .links a:nth-child(2) { animation-delay: .16s; }
    .is-open .links a:nth-child(3) { animation-delay: .24s; }
    .is-open .nav :global(.lang-switch) { animation-delay: .34s; }
  }
  @keyframes nav-in { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .nav, .nav-toggle .bar { transition: none; }
    .links a, .nav :global(.lang-switch) { opacity: 1; transform: none; }
    .is-open .links a, .is-open .nav :global(.lang-switch) { animation: none; }
  }
</style>
