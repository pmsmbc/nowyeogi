---
import LocalCurrency from '../components/LocalCurrency.astro';
// Pretendard 를 jsDelivr 대신 빌드에 포함한다(외부 CSS 가 렌더링을 막아 모바일 LCP 가 늦었다, 2026-10-13 감사)
import 'pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css';
import '../styles/global.css';
import siteConfig, { type Lang } from '../site.config';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LangRedirect from '../components/LangRedirect.astro';
import { t } from '../i18n/ui';
import { localePath } from '../lib/postUtils';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path: string;
  alternates?: Partial<Record<Lang, string>>;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: object[];
  publishedTime?: Date;
  modifiedTime?: Date;
  keywords?: string[];
  noindex?: boolean;
  /** 홈에서만 켠다. 방문자를 브라우저 언어 홈으로 한 번 보낸다. */
  autoLang?: boolean;
}
const { lang, alternates, autoLang = false, ...seo } = Astro.props;
const client = siteConfig.adsense.client.trim();
const gsc = siteConfig.verification.google.trim();
const bing = siteConfig.verification.bing.trim();
const naver = siteConfig.verification.naver.trim();
// 분석은 GTM 하나로만 넣는다. GA4(G-7PGFM9SSFQ)는 GTM 컨테이너 안의 태그로 보낸다. 직접 삽입은 2026-10-13 에 뺐다(둘 다 있으면 gtag.js 가 두 번 로드되고 방문이 이중 집계된다).
const gtm = siteConfig.gtm.id.trim();
const gtmScript = gtm
  ? "(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','" + gtm + "');"
  : '';
const gtmNoscript = gtm
  ? '<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=' + gtm + '" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>'
  : '';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {gtm && <script is:inline set:html={gtmScript} />}
    {gsc && <meta name="google-site-verification" content={gsc} />}
    {bing && <meta name="msvalidate.01" content={bing} />}
    {naver && <meta name="naver-site-verification" content={naver} />}
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/brand/logo-mark-192.png" />
    {lang === 'ja' && <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />}
    {lang === 'ja' && <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&display=swap" />}
    <link rel="alternate" type="application/rss+xml" title={siteConfig.name[lang]} href={localePath(lang, '/rss.xml')} />
    <Seo lang={lang} alternates={alternates} {...seo} />
    {/* 애드센스 사이트 소유권 확인용 메타 태그. 코드 스니펫·ads.txt 와 함께 세 방법을 모두 둔다 */}
    {client && <meta name="google-adsense-account" content={client} />}
    {client && <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${client}`} crossorigin="anonymous"></script>}
    {autoLang && <LangRedirect />}
  </head>
  <body class={lang === 'ja' ? 'lang-ja' : undefined}>
    {gtm && <Fragment set:html={gtmNoscript} />}
    <a class="skip-link" href="#main">{t(lang, 'a11y.skip')}</a>
    <Header lang={lang} alternates={alternates} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    {lang === 'en' && <LocalCurrency />}
  </body>
</html>
